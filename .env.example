# Environment
NODE_ENV=development

# Server
PORT=5080

# Database - Local MongoDB (default for easy local development)
MONGODB_URI=mongodb://localhost:27017/figure-collecting-dev

# Database - MongoDB Atlas (alternative for cloud testing)
# Uncomment and replace placeholders to use Atlas instead of local MongoDB
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/figure-collecting?retryWrites=true&w=majority

# JWT Secrets - REQUIRED
# Generate secure random secrets using: openssl rand -base64 32
# Or run ./setup-local-env.sh to auto-generate
JWT_SECRET=your_jwt_secret_here_replace_with_generated_secret
JWT_REFRESH_SECRET=your_refresh_secret_here_replace_with_generated_secret

# JWT Configuration
ACCESS_TOKEN_EXPIRY=15m

# Refresh Token Rotation (optional security feature)
# Enable this to rotate refresh tokens on each use (recommended for production)
# ROTATE_REFRESH_TOKENS=true

# Services
# Local development
SCRAPER_SERVICE_URL=http://localhost:3080
# Docker/Coolify deployment (must match service/network name)
# SCRAPER_SERVICE_URL=http://scraper:3050
# SCRAPER_SERVICE_URL=http://scraper-dev:3090

# media-manager service (figure image matting + display metadata)
# Local development
MEDIA_MANAGER_URL=http://localhost:8000
# Docker/Coolify deployment (must match service/network name)
# MEDIA_MANAGER_URL=http://media-manager:8000
# Optional service-to-service JWT sent as `Authorization: Bearer <token>`
# MEDIA_MANAGER_SERVICE_TOKEN=your_service_token_here

# spine read RPC (read.v1 SpineRead.Compare, GET /compare/by-gtin|by-head) — Connect over
# cleartext HTTP/1.1. Unset = degraded mode (503 SPINE_READ_UNCONFIGURED), e.g. on Coolify
# pre-k3s-cutover where the cluster-internal spine service is unreachable. No default: never
# point this at anything real by accident.
# SPINE_READ_URL=http://ingest-server.fc.svc.cluster.local:50051
# Optional per-call timeout override (ms); default 10000.
# SPINE_READ_TIMEOUT_MS=10000

# ── inventory-level entitlement gate (D6 U6) ────────────────────────────────────────────
# The spine withholds per-store stock MAGNITUDES unless the caller proves the
# `inventory_levels` entitlement. Availability is NOT gated — only the numbers.
# EVERYTHING BELOW IS OPTIONAL. Unset, no assertion is ever sent and every spine read comes
# back with magnitudes withheld and `coverage.redacted` naming what was left out — a normal
# 200, never an error. A misconfiguration here shows LESS, it does not break or open the gate.
#
# Signing key: Ed25519 PKCS#8 PEM. Lives in OpenBao at secret/figure-collecting/entitlement-signing
# and reaches the pod as a mounted Secret. NEVER commit one, never log one.
# ENTITLEMENT_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ...or point at the projected file instead, which is what a Secret mount gives you:
# ENTITLEMENT_SIGNING_KEY_FILE=/etc/fc/entitlement-signing/ent-2026-09.key
# Key id carried in the assertion. With a FILE it defaults to the basename minus the
# extension (mirroring the spine's `<kid>.pub` naming); with an inline PEM it is required.
# ENTITLEMENT_SIGNING_KID=ent-2026-09
#
# OpenFGA — the Check that decides whether anything is minted. Any error is a DENY.
# OPENFGA_API_URL=http://openfga.authz.svc.cluster.local:8080
# OPENFGA_STORE_ID=01KXA5NRJYR0GYKX4NWQ2ANDZS
# OPENFGA_API_TOKEN=your_preshared_key_here
# Pin the model so a rollout cannot change an answer mid-flight (optional):
# OPENFGA_MODEL_ID=01KXA5NRMNY7C8MZETNYXQT1CJ
# Tenant object to check against; default app:figurecollecting
# OPENFGA_APP_OBJECT=app:figurecollecting
# Per-Check timeout (ms); default 2000 — this is a blocking hop inside a user-facing read.
# OPENFGA_TIMEOUT_MS=2000
# How long a Check result is reused per user (ms); default 30000.
# ENTITLEMENT_GRANT_CACHE_TTL_MS=30000
# How long a FAILED Check is remembered (ms); default 5000 — short, so an OpenFGA blip does
# not pin a user out for the full TTL, but long enough to damp a retry storm.
# ENTITLEMENT_GRANT_ERROR_TTL_MS=5000
# Ceiling on cached subjects before the oldest are evicted; default 10000.
# ENTITLEMENT_GRANT_CACHE_MAX=10000
#
# EVERY NUMERIC VALUE ABOVE MUST BE > 0. Zero is not a smaller bound, it is the absence of one
# (axios reads timeout:0 as "wait forever"), so a non-positive or nonsensical value is ignored
# in favour of the documented default.

# Admin Bootstrap Token (optional)
# Used for one-time admin privilege grant via POST /admin/bootstrap
# Generate a secure random token: openssl rand -base64 32
# After granting admin, this can be removed or changed
# ADMIN_BOOTSTRAP_TOKEN=your_bootstrap_token_here

# MongoDB Atlas Search (optional)
# Enable Atlas Search features for environments connected to Atlas with search indexes
# Set to 'true' on any environment with Atlas Search indexes configured
# Regex fallback is used when disabled or when TEST_MODE=memory
# ENABLE_ATLAS_SEARCH=true

# Debug Logging (optional)
# DEBUG=true enables all application loggers (AUTH, SYNC, MAIN, etc.)
# DEBUG_LEVEL=verbose|info|warn|error (default: info in development, error in production)
# DEBUG_MODULES=AUTH,SYNC,MAIN (enable specific modules only, or * for all)
# DEBUG=true
# DEBUG_LEVEL=info
# DEBUG_MODULES=*
# SERVICE_AUTH_TOKEN_DEBUG=false

# ═══════════════════════════════════════════════
# Auth Modernization (Email Verification, 2FA, Passkeys)
# ═══════════════════════════════════════════════

# Email (Resend) — leave RESEND_API_KEY empty for console fallback in dev
# RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@figurecollecting.com
FRONTEND_URL=http://localhost:5081
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_GRACE_DAYS=7

# TOTP encryption — generate with: openssl rand -hex 32
# TOTP_ENCRYPTION_KEY=<64-char-hex-string>

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME=FigureCollecting
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5081
